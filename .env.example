# Khan Market Afghanistan

# Core application
NODE_ENV=development
PORT=4000
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khan_market_afghanistan

# Auth and security
SESSION_TTL_MS=86400000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# AI policy
AI_CONTROL_CENTER=enabled
AI_REGISTRY=enabled
AI_ROUTER=enabled
AI_PROVIDER_MODE=STRICT
AI_PAID_SPENDING_DISABLED=true
AUTOMATIC_PAID_SPENDING=DISABLED

# Local/self-hosted OpenAI-compatible
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_API_KEY=
LOCAL_OPENAI_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Application RBAC
DEFAULT_USER_ROLE=USER
DEFAULT_ADMIN_EMAIL=
